<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:BEN_TOOLBOX_2_0.Services"
        x:Class="BEN_TOOLBOX_2_0.Views.MainWindow"
        Title="BEN TOOLBOX 2.0"
        Width="1920" Height="1080" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#070E19" Foreground="#E8F4FF"
        FontFamily="Inter">
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9DAEC5"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#24314A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#203754"/>
      <Setter Property="Foreground" Value="#82D9F3"/>
    </Style>
    <Style Selector="Button.tile">
      <Setter Property="Background" Value="#101E2F"/>
      <Setter Property="BorderBrush" Value="#2A5771"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.tile:pointerover">
      <Setter Property="Background" Value="#16334B"/>
      <Setter Property="BorderBrush" Value="#68DFF5"/>
    </Style>
    <Style Selector="Button.app-close">
      <Setter Property="Background" Value="#17283A"/>
      <Setter Property="BorderBrush" Value="#39556B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Foreground" Value="#B6CADC"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.app-close:pointerover">
      <Setter Property="Background" Value="#733042"/>
      <Setter Property="BorderBrush" Value="#EE8390"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Dashboard V2 / D1: reusable static HUD primitives. No animations or runtime polling. -->
    <Style Selector="Border.hud">
      <Setter Property="Background" Value="#102137"/>
      <Setter Property="BorderBrush" Value="#2B617D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="TextBlock.hud-label">
      <Setter Property="Foreground" Value="#85CEE5"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="LetterSpacing" Value="1.6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.hud-muted">
      <Setter Property="Foreground" Value="#91A8BE"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="242,*" RowDefinitions="*">
    <Border Grid.Column="0" Background="#0D1828" BorderBrush="#24516B" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,20">
        <StackPanel Grid.Row="0" Margin="6,0,0,32" Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Background="#15374D" BorderBrush="#4CC7E4" BorderThickness="1" CornerRadius="6" Width="40" Height="40">
              <TextBlock Text="B" FontSize="23" FontWeight="Bold" Foreground="#83E2F2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="BEN TOOLBOX" FontWeight="Bold" FontSize="15" LetterSpacing="1.1"/>
              <TextBlock Text="VERSION 2.0" Foreground="#6D8FAA" FontSize="10" LetterSpacing="2"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="3">
          <TextBlock Text="NAVIGATION  /  01" Foreground="#6B809B" FontSize="11" LetterSpacing="2" Margin="14,0,0,10"/>
          <Button x:Name="DashboardNav" Classes="nav active" Click="NavigateDashboard"><TextBlock Text="⌂    Dashboard"/></Button>
          <Button x:Name="GameNav" Classes="nav" Click="NavigateGame"><TextBlock Text="◆    Game Development"/></Button>
          <Button x:Name="FilesNav" Classes="nav" Click="NavigateFiles"><TextBlock Text="▦    File Toolbox"/></Button>
          <Button x:Name="InspectNav" Classes="nav" Click="NavigateInspect"><TextBlock Text="◉    Inspectors"/></Button>
          <Button x:Name="SettingsNav" Classes="nav" Click="NavigateSettings"><TextBlock Text="✦    Settings"/></Button>
        </StackPanel>
        <Border Grid.Row="3" CornerRadius="12" Padding="14" Background="#1A293B" BorderBrush="#294359" BorderThickness="1">
          <StackPanel Spacing="5">
            <TextBlock Text="●  SYSTEM ONLINE" Foreground="#7CDEBF" FontWeight="SemiBold" FontSize="11"/>
            <TextBlock Text="UI CORE / 1.1  •  LOCAL" Foreground="#99AAC0" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="70,*">
      <Border Grid.Row="0" BorderBrush="#253247" BorderThickness="0,0,0,1" Background="#0B1828">
        <Grid ColumnDefinitions="*,Auto" Margin="32,0" VerticalAlignment="Center">
          <TextBlock Text="BTX-02  /  DEVELOPMENT CONTROL INTERFACE" FontSize="11" FontWeight="SemiBold" Foreground="#7D93AF" LetterSpacing="2" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Background="#1C2A3B" CornerRadius="20" Padding="13,7" VerticalAlignment="Center">
              <TextBlock Text="●  LOCAL TERMINAL     /     ONLINE" Foreground="#A2D9ED" FontSize="12"/>
            </Border>
            <!-- Always-visible close control, including when native title-bar buttons are obscured. -->
            <Button Classes="app-close" Width="36" Height="32" Click="CloseToolbox"
                    ToolTip.Tip="Close BEN TOOLBOX" AutomationProperties.Name="Close BEN TOOLBOX">
              <TextBlock Text="×" FontSize="21" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,36" Spacing="19">
          <StackPanel Spacing="8">
            <TextBlock x:Name="PageKicker" Text="CONTROL DECK  /  OVERVIEW" Foreground="#61C8EB" FontSize="11" LetterSpacing="2"/>
            <TextBlock x:Name="PageTitle" Text="Command Center" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="PageSubtitle" Text="Modular utilities  /  Developer operations  /  System oversight" Foreground="#9BAFC8" FontSize="14" TextWrapping="Wrap"/>
          </StackPanel>
          <!-- D1: dashboard-only content. A single parent is toggled by ShowSection(). -->
          <StackPanel x:Name="DashboardPanel" Spacing="17">
            <!-- Real local clock refreshes only while the dashboard is visible. -->
            <Border Classes="hud" Background="#0E2237" Padding="14">
              <Grid>
                <!-- Static, low-cost HUD corner brackets over the command strip. -->
                <Border Width="36" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-13,-13,0,0" Background="#57D3EC" IsHitTestVisible="False"/>
                <Border Width="2" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-13,-13,0,0" Background="#57D3EC" IsHitTestVisible="False"/>
                <Border Width="36" Height="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-13,-13" Background="#2F829D" IsHitTestVisible="False"/>
                <Border Width="2" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-13,-13" Background="#2F829D" IsHitTestVisible="False"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="5" VerticalAlignment="Center">
                  <TextBlock Classes="hud-label" Text="◈  BTX-02 / LOCAL CONTROL DECK"/>
                  <TextBlock Text="DESKTOP INTERFACE ACTIVE" FontSize="15" FontWeight="SemiBold" Foreground="#E7F6FF"/>
                  <TextBlock Classes="hud-muted" Text="Native utilities online  •  Local-only execution"/>
                </StackPanel>
                <Border Grid.Column="1" Classes="hud" Background="#0C1A2A" BorderBrush="#36768C" Padding="14,9" MinWidth="154">
                  <StackPanel Spacing="4" HorizontalAlignment="Right">
                    <TextBlock Classes="hud-label" Text="SYSTEM TIME  /  LOCAL" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="DashboardTimeText" Text="--:--:--" FontSize="27" FontWeight="SemiBold" Foreground="#DAF5FC" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="DashboardDateText" Text="Local date pending" FontSize="10" Foreground="#7E9CB2" HorizontalAlignment="Right"/>
                  </StackPanel>
                </Border>
                </Grid>
              </Grid>
            </Border>

            <!-- Wrapping panels: at the 900px minimum window, stack rather than clip. -->
            <WrapPanel x:Name="DashboardStatusWrap" Orientation="Horizontal">
              <Border x:Name="DashboardStatusCard" Classes="hud" Width="432" MinHeight="222" Margin="0,0,12,12" Background="#10273B" Padding="16">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="hud-label" Text="◈  SYSTEM STATUS  /  ACTIVE SESSION"/>
                    <TextBlock Grid.Column="1" Text="●  LOCAL" Foreground="#75D9B9" FontSize="10" FontWeight="SemiBold"/>
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="*,96" ColumnSpacing="12">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="All systems standing by." FontSize="20" FontWeight="SemiBold" Foreground="#F1FBFF" TextWrapping="Wrap"/>
                      <TextBlock Text="Your native toolbox modules are available below. Remote execution is not enabled." FontSize="12" Foreground="#A8C2D2" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#0D2032" BorderBrush="#316A85" BorderThickness="1" CornerRadius="6" Padding="9">
                      <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Classes="hud-label" Text="SYSTEM LINK" HorizontalAlignment="Center" FontSize="9"/>
                        <TextBlock Text="◎" FontSize="51" Foreground="#62D9EF" HorizontalAlignment="Center"/>
                        <TextBlock Text="UI READY" FontSize="10" Foreground="#89DCB8" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="hud-label" Text="SESSION" FontSize="9"/>
                      <TextBlock Text="Local terminal" FontSize="12" Foreground="#E0F0FB"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Classes="hud-label" Text="UPTIME" FontSize="9"/>
                      <TextBlock x:Name="DashboardUptimeText" Text="00:00:00" FontSize="12" Foreground="#ACBED0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Classes="hud-label" Text="ACCESS" FontSize="9"/>
                      <TextBlock Text="On this PC" FontSize="12" Foreground="#E0F0FB"/>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
              <Border x:Name="DashboardTelemetryCard" Classes="hud" Width="432" MinHeight="222" Margin="0,0,0,12" Padding="14" Background="#0F2135">
                <StackPanel Spacing="11">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="hud-label" Text="▥  SYSTEM TELEMETRY  /  D2"/>
                    <TextBlock Grid.Column="1" x:Name="DashboardTelemetryStateText" Text="CONNECTING" Foreground="#E1B36B" FontSize="9" FontWeight="SemiBold"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Background="#0A1929" BorderBrush="#245A74" BorderThickness="1" CornerRadius="5" Padding="10">
                      <StackPanel Spacing="7">
                        <TextBlock Classes="hud-label" Text="CPU USAGE" FontSize="9"/>
                        <TextBlock x:Name="DashboardCpuValueText" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#6CCFE7"/>
                        <Grid Height="64" ClipToBounds="True" Background="#0A1B2A">
                          <StackPanel VerticalAlignment="Center" Spacing="16" Opacity="0.3" IsHitTestVisible="False">
                            <Border Height="1" Background="#316481"/>
                            <Border Height="1" Background="#316481"/>
                            <Border Height="1" Background="#316481"/>
                          </StackPanel>
                          <TextBlock Text="AWAITING D3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#67869E" FontSize="10" LetterSpacing="1"/>
                        </Grid>
                        <TextBlock x:Name="DashboardCpuDetailText" Text="Sampling system load..." FontSize="10" Foreground="#8DA9BB"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#0A1929" BorderBrush="#655639" BorderThickness="1" CornerRadius="5" Padding="10">
                      <StackPanel Spacing="7">
                        <TextBlock Text="RAM USAGE" Foreground="#E2B46D" FontSize="9" FontWeight="SemiBold" LetterSpacing="1.4"/>
                        <TextBlock x:Name="DashboardRamValueText" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#E1B66F"/>
                        <Grid Height="64" ClipToBounds="True" Background="#101C28">
                          <StackPanel VerticalAlignment="Center" Spacing="16" Opacity="0.25" IsHitTestVisible="False">
                            <Border Height="1" Background="#8E7043"/>
                            <Border Height="1" Background="#8E7043"/>
                            <Border Height="1" Background="#8E7043"/>
                          </StackPanel>
                          <TextBlock Text="AWAITING D3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9B7E57" FontSize="10" LetterSpacing="1"/>
                        </Grid>
                        <TextBlock x:Name="DashboardRamDetailText" Text="Checking physical RAM..." FontSize="10" Foreground="#A7A194"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
            </WrapPanel>

            <!-- Hardware cards deliberately do not invent machine specs or measurements. -->
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="HARDWARE OVERVIEW" FontSize="17" FontWeight="SemiBold" Foreground="#F0F9FF"/>
                  <TextBlock Classes="hud-label" Text="/ SYSTEM RESOURCES" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="DashboardProvidersText" Text="DATA  /  WINDOWS" Foreground="#66889E" VerticalAlignment="Center" FontSize="10"/>
              </Grid>
              <WrapPanel x:Name="DashboardHardwareWrap" Orientation="Horizontal">
                <Border x:Name="DashboardCpuHardwareCard" Classes="hud" Width="217" MinHeight="155" Margin="0,0,8,8" Padding="13" Background="#111F33">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="hud-label" Text="◈  PROCESSOR"/>
                      <TextBlock Grid.Column="1" Text="CPU" Foreground="#5C92B0" FontSize="9"/>
                    </Grid>
                    <TextBlock x:Name="DashboardCpuModelText" Text="Detecting CPU model..." FontSize="13" Foreground="#DCE9F5" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DashboardCpuLoadText" Text="—" FontSize="24" Foreground="#65D3EA"/>
                    <Border Background="#173149" Height="2"/>
                    <TextBlock x:Name="DashboardCpuCoresText" Text="Hardware detection pending" FontSize="10" Foreground="#8096A9"/>
                  </StackPanel>
                </Border>
                <Border x:Name="DashboardGpuHardwareCard" Classes="hud" Width="217" MinHeight="155" Margin="0,0,8,8" Padding="13" Background="#111F33">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="hud-label" Text="◉  GRAPHICS"/>
                      <TextBlock Grid.Column="1" Text="GPU" Foreground="#5C92B0" FontSize="9"/>
                    </Grid>
                    <TextBlock Text="GPU sensors deferred" FontSize="13" Foreground="#DCE9F5" TextWrapping="Wrap"/>
                    <TextBlock Text="—" FontSize="24" Foreground="#65D3EA"/>
                    <Border Background="#173149" Height="2"/>
                    <TextBlock Text="GPU SENSORS  /  PLANNED" FontSize="10" Foreground="#8096A9"/>
                  </StackPanel>
                </Border>
                <Border x:Name="DashboardMemoryHardwareCard" Classes="hud" Width="217" MinHeight="155" Margin="0,0,8,8" Padding="13" Background="#151F30" BorderBrush="#615439">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="▥  MEMORY" Foreground="#E5B86A" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.4"/>
                      <TextBlock Grid.Column="1" Text="RAM" Foreground="#AC8653" FontSize="9"/>
                    </Grid>
                    <TextBlock x:Name="DashboardMemoryModelText" Text="Physical memory" FontSize="13" Foreground="#DCE9F5" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DashboardMemoryUsedText" Text="—" FontSize="24" Foreground="#E6BB7A"/>
                    <Border Background="#443A2C" Height="2"/>
                    <TextBlock x:Name="DashboardMemoryDetailText" Text="Memory reading pending" FontSize="10" Foreground="#AE9A7D"/>
                  </StackPanel>
                </Border>
                <Border x:Name="DashboardDriveHardwareCard" Classes="hud" Width="217" MinHeight="155" Margin="0,0,0,8" Padding="13" Background="#151F30" BorderBrush="#615439">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="▤  DRIVE SPACE" Foreground="#E5B86A" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.4"/>
                      <TextBlock Grid.Column="1" Text="DISK" Foreground="#AC8653" FontSize="9"/>
                    </Grid>
                    <TextBlock x:Name="DashboardDriveNameText" Text="Local storage" FontSize="13" Foreground="#DCE9F5" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DashboardDriveCapacityText" Text="—" FontSize="24" Foreground="#E6BB7A"/>
                    <ProgressBar x:Name="DashboardDriveProgress" Minimum="0" Maximum="100" Value="0" Height="5" Background="#443A2C" Foreground="#E1B46A" BorderThickness="0"/>
                    <TextBlock x:Name="DashboardDriveDetailText" Text="Scanning local disks..." FontSize="10" Foreground="#AE9A7D"/>
                  </StackPanel>
                </Border>
              </WrapPanel>
            </StackPanel>

            <!-- Preserve the four existing module buttons and their navigation callbacks. -->
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock x:Name="SectionHeading" Text="Available modules" FontSize="20" FontWeight="SemiBold" Foreground="#E9F8FF"/>
                  <TextBlock Classes="hud-label" Text="/ QUICK ACCESS" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="04 MODULES  /  LOCAL" Foreground="#66889E" FontSize="10" VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Button x:Name="GameTile" Grid.Row="0" Grid.Column="0" Classes="tile" Click="NavigateGame" MinHeight="128">
                  <StackPanel Spacing="8">
                    <TextBlock Text="◆    01 / DEVELOPMENT" FontSize="12" Foreground="#77D7EE" LetterSpacing="1.2"/>
                    <TextBlock Text="GAME DEVELOPMENT   ›" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Sprites, artwork and game resources." Foreground="#95A8BD" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                </Button>
                <Button x:Name="FilesTile" Grid.Row="0" Grid.Column="1" Classes="tile" Click="NavigateFiles" MinHeight="128">
                  <StackPanel Spacing="8">
                    <TextBlock Text="▦    02 / FILE MANAGEMENT" FontSize="12" Foreground="#A3A8FF" LetterSpacing="1.2"/>
                    <TextBlock Text="FILE TOOLBOX   ›" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Backups, duplicates and file organization." Foreground="#95A8BD" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                </Button>
                <Button x:Name="InspectTile" Grid.Row="1" Grid.Column="0" Classes="tile" Click="NavigateInspect" MinHeight="128">
                  <StackPanel Spacing="8">
                    <TextBlock Text="◎    03 / INSPECTION" FontSize="12" Foreground="#84DDB4" LetterSpacing="1.2"/>
                    <TextBlock Text="INSPECTORS   ›" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Lighting, resource usage and diagnostics." Foreground="#95A8BD" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                </Button>
                <Button x:Name="SettingsTile" Grid.Row="1" Grid.Column="1" Classes="tile" Click="NavigateSettings" MinHeight="128">
                  <StackPanel Spacing="8">
                    <TextBlock Text="✦    04 / CONFIGURATION" FontSize="12" Foreground="#EBC58A" LetterSpacing="1.2"/>
                    <TextBlock Text="SETTINGS   ›" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Appearance, preferences and integrations." Foreground="#95A8BD" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="ToolListPanel" IsVisible="False" Spacing="12">
            <TextBlock Text="AVAILABLE UTILITIES  /  SELECT TO LAUNCH" Foreground="#76D0EA" FontSize="11" LetterSpacing="1.5"/>
            <ItemsControl x:Name="ToolsView">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:ToolDefinition">
                  <Border Background="#112338" BorderBrush="#28516E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" Foreground="#E7F7FF"/>
                        <TextBlock Text="{Binding Description}" Foreground="#9DB6CA" TextWrapping="Wrap" FontSize="13"/>
                        <TextBlock Text="{Binding Status}" Foreground="#75BED1" FontSize="11"/>
                      </StackPanel>
                      <Button Grid.Column="1" Content="LAUNCH  ›" MinWidth="124" VerticalAlignment="Center"
                              Background="#16415A" Foreground="#AAEFFF" BorderBrush="#3E8EA8" BorderThickness="1"
                              CornerRadius="5" Padding="14,10" Tag="{Binding}" Click="LaunchTool"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Border Background="#0D1C2C" CornerRadius="7" BorderBrush="#25516D" BorderThickness="1" Padding="18">
            <StackPanel Spacing="6">
              <TextBlock x:Name="InfoTitle" Text="BUILD 1.1   /   SYSTEM READOUT" Foreground="#76D0EA" FontWeight="SemiBold" FontSize="11" LetterSpacing="1.5"/>
              <TextBlock x:Name="InfoDescription" Text="Interface online. Navigation active. Desktop tool execution remains offline until Stage 2." Foreground="#A6B8CC" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>